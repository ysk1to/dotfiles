#!/bin/bash
# jq が必要（Brewfile に記載）
# Claude Code の statusLine から呼ばれる。
# プランの使用率（rate_limits）を tmux 用にキャッシュし、ステータス行を出力する。
# 例: 🤖 Opus 5.5 ⚡medium │ 📂 ~/dotfiles │ 🌿 master │ 🧠 94.5K ▰▱▱▱▱▱▱▱▱▱ 9% │ 🔖 dotfiles差分の統合提案 │ 📦 v2.1.311

cache="${XDG_CACHE_HOME:-$HOME/.cache}/claude-rate-limits.json"
input=$(cat)

limits=$(echo "$input" | jq -c '.rate_limits // empty')
if [ -n "$limits" ]; then
  mkdir -p "$(dirname "$cache")"
  echo "$limits" > "$cache.tmp" && mv "$cache.tmp" "$cache"
fi

cwd=$(echo "$input" | jq -r '.workspace.current_dir // .cwd // empty')
branch=$([ -n "$cwd" ] && git -C "$cwd" --no-optional-locks branch --show-current 2>/dev/null)

# コンテキスト使用率は 50% 未満を緑、80% 未満を黄、それ以上を赤で表示する
echo "$input" | jq -r --arg home "$HOME" --arg branch "$branch" '
  def esc(c): "\u001b[\(c)m";
  def paint(c): "\(esc(c))\(.)\(esc("0"))";
  def human: if . >= 1000 then "\(. / 100 | floor / 10)K" else "\(.)" end;
  def bar(p): (p / 10 | floor) as $n | ("▰" * $n) + ("▱" * (10 - $n));
  def effort_icon: {low: "🌱", medium: "⚡", high: "🔥", xhigh: "🚀", max: "💥"}[.] // "⚙️";
  (.context_window.current_usage // {}) as $u
  | (($u.input_tokens // 0) + ($u.cache_creation_input_tokens // 0) + ($u.cache_read_input_tokens // 0)) as $tokens
  | (.context_window.used_percentage // 0 | floor) as $pct
  | (if $pct >= 80 then "1;31" elif $pct >= 50 then "1;33" else "1;32" end) as $color
  | ((.workspace.current_dir // .cwd // "") | if startswith($home) then "~" + .[($home | length):] else . end) as $dir
  | [
      "🤖 \(.model.display_name | paint("1;38;5;209"))\(if .effort.level then " \(.effort.level | effort_icon)\(.effort.level | paint("38;5;180"))" else "" end)",
      "📂 \($dir | paint("1;36"))",
      (if $branch != "" then "🌿 \($branch | paint("1;35"))" else empty end),
      "🧠 \($tokens | human) \(bar($pct) | paint($color)) \("\($pct)%" | paint($color))",
      (if .session_name then "🔖 \(.session_name | paint("3;38;5;153"))" else empty end),
      "📦 \("v\(.version)" | paint("2"))"
    ]
  | join(" \("│" | paint("2")) ")
'
