#!/bin/bash
# claude-auto-dev の状況を、tmux の監視用のペインに流し続ける。上にリポジトリごとの状況、中に実行中の回の手順
# （claude の stream-json の出力から、最後の5回のツールの呼び出し）、下に全リポジトリのできごと
# （claude-auto-dev が残す events.tsv）を新しい順に出す。判断待ちや見落とし・失敗があれば、ペインを待機中
# （@claude_state = waiting。ほかの Claude のペインと同じ赤い枠）にする。
# 使い方: claude-auto-dev-watch [--once | --toggle] [--repo リポジトリ名]
#   --once で1回だけ出して終わる / --toggle で監視用のペインを開け閉めする（C-q + M）
#   --repo でそのリポジトリの状況・実行中の回・できごとだけを出す。--toggle は、今のペインのリポジトリに絞って開く
# 状況は tmux-claude-auto-dev と同じキャッシュを読み、古ければ tmux-claude-auto-dev に裏で取り直させる。
# 書き直す間隔は CLAUDE_AUTO_DEV_WATCH_INTERVAL（秒、既定 10）、開くときの幅は CLAUDE_AUTO_DEV_WATCH_WIDTH（既定 60）

bar="$(dirname "$0")/tmux-claude-auto-dev"
cache="${XDG_CACHE_HOME:-$HOME/.cache}/claude-auto-dev-status.json"
state_dir="${CLAUDE_AUTO_DEV_STATE_DIR:-$HOME/.local/state/claude-auto-dev}"

mode='' repo=''
while [ $# -gt 0 ]; do
  case "$1" in
    --once | --toggle) mode=$1 ;;
    --repo) repo=$2; shift ;;
  esac
  shift
done

# 印（@auto_dev_watch）の付いたペインがあれば閉じ、なければ右下のペインを左右に割って開く。
# 今のペインがリポジトリ（worktree なら元のリポジトリ）の中なら、そのリポジトリに絞る
if [ "$mode" = --toggle ]; then
  pane=$(tmux list-panes -F '#{pane_id} #{@auto_dev_watch}' | awk '$2 == 1 { print $1; exit }')
  if [ -n "$pane" ]; then
    tmux kill-pane -t "$pane"
  else
    cmd=$0
    common=$(git -C "$(tmux display -p '#{pane_current_path}')" rev-parse --path-format=absolute --git-common-dir 2>/dev/null) &&
      cmd="$0 --repo $(printf '%q' "$(basename "$(dirname "$common")")")"
    tmux split-window -d -h -l "${CLAUDE_AUTO_DEV_WATCH_WIDTH:-60}" -t '{bottom-right}' "$cmd"
  fi
  exit 0
fi

# 状況のキャッシュを、--repo のリポジトリだけに絞って出す
status() {
  jq --arg repo "$repo" 'if $repo == "" then . else map(select(.name == $repo)) end' "$cache" 2>/dev/null
}

if [ -n "$TMUX_PANE" ]; then
  tmux set -p -t "$TMUX_PANE" @auto_dev_watch 1
  printf '\033]2;%s\033\134' auto-dev
fi

frame() {
  local now rows cols running events steps name file
  now="${CLAUDE_AUTO_DEV_NOW:-$(date +%s)}"
  rows="${LINES:-$(tput lines)}"
  cols="${COLUMNS:-$(tput cols)}"
  "$bar" > /dev/null
  running=$("$bar" --running | jq -c --arg repo "$repo" 'if $repo == "" then . else with_entries(select(.key == $repo)) end')
  events=$(awk -F '\t' -v repo="$repo" 'repo == "" || $2 == repo' "$state_dir/events.tsv" 2>/dev/null | tail -n 200)
  # 実行中の回ごとに、最後の5回のツールの呼び出し（ツール名と対象）。書きかけの行は読み飛ばす
  steps='{}'
  for name in $(jq -r 'keys[]' <<< "$running"); do
    file=$(jq -r --arg name "$name" '.[$name].stream // empty' <<< "$running")
    [ -f "$file" ] || continue
    steps=$(tail -n 200 "$file" | jq -Rnc --arg name "$name" --arg wt "$state_dir/worktrees/$name/" --argjson steps "$steps" '
      [inputs | fromjson? | select(.type == "assistant") | .message.content[]? | select(.type == "tool_use")
        | {name: (.name | sub("^mcp__claude_ai_"; "")),
           target: (.input | .file_path // .command // .pattern // .path // .url // .description // "" | tostring
             | ltrimstr($wt) | gsub("\n"; " "))}]
      | $steps + {($name): .[-5:]}') || steps='{}'
  done
  if [ ! -s "$cache" ] || [ "$(status | jq length)" = 0 ]; then
    echo "claude-auto-dev はまだ動いていません"
    return
  fi
  jq -r --argjson running "$running" --argjson steps "$steps" --argjson now "$now" --argjson rows "$rows" --argjson cols "$cols" \
    --arg events "$events" '
    def duration: (. / 60 | round) as $m | if $m >= 60 then "\($m / 60 | floor)h\($m % 60 | tostring | if length < 2 then "0" + . else . end)m" else "\($m)m" end;
    def elapsed: (($now - .) / 60 | floor) as $m | if $m >= 60 then "\($m / 60 | floor)h\($m % 60 | tostring | if length < 2 then "0" + . else . end)m" else "\($m)m" end;
    # 今日なら時刻、それより前なら日付
    def when: if strflocaltime("%Y%m%d") == ($now | strflocaltime("%Y%m%d")) then strflocaltime("%H:%M") else strflocaltime("%m/%d") end;
    # 端末での幅（全角は2、記号（…など）と罫線は1、絵文字の異体字セレクタは0）で切る
    def cw: if . == 65039 then 0 elif (. >= 8192 and . <= 8303) or (. >= 9472 and . <= 9599) then 1 elif . > 4351 then 2 else 1 end;
    def trunc($w):
      if (explode | map(cw) | add // 0) <= $w then .
      else (reduce explode[] as $c ({s: [], w: 0, full: false};
          if .full or .w + ($c | cw) > $w - 1 then .full = true else .s += [$c] | .w += ($c | cw) end) | .s | implode) + "…" end;
    def run: if .mode == "implement" then "#\(.issue) の実装" elif .mode == "plan" then "企画" else "精査" end + " \(.started_at | elapsed)";
    def repo:
      ($running[.name] // null) as $r
      | [if $r then "🏃 \($r | run)" else empty end,
         if (.decisions | length) > 0 then "🙋 " + ([.decisions[] | "#\(.number)"] | join(" ")) else empty end,
         if (.prs | length) > 0 then "🔀 " + ([.prs[] | "#\(.number)"] | join(" ")) else empty end,
         if .ready > 0 then "📥 \(.ready)" else empty end] as $items
      | [if .schedule.missed_at then "🚨 \(.schedule.missed_at | when) の起動が記録されていません" else empty end,
         if .error then "🚨 \(.error)" else empty end,
         (.notices[] | select(.title | test("失敗")) | "🚨 \(.at | when) \(.message)")] as $warns
      | [if .schedule.next_at then "⏩ \(.schedule.next_at | strflocaltime("%H:%M"))" else empty end,
         if .runs.today.count > 0 then "🔁 \(.runs.today.count)  ⏳ \(.runs.today.duration // 0 | duration)" else empty end] as $plan
      | "\(.label)  " + (if ($items + $warns | length) == 0 then "✓" else $items | join("   ") end),
        ($warns[] | "     " + .),
        (if ($plan | length) > 0 then "     " + ($plan | join("  ")) else empty end);
    def rule($title): $title + " " + ("─" * ([$cols - ($title | explode | map(cw) | add) - 1, 0] | max));
    # 実行中の回の見出しと、ツールの呼び出し（新しいものが下）
    def live:
      .label as $label | ($running[.name] // empty) as $r
      | rule("── 実行中 \($label) \($r | run)"),
        (($steps[.name] // [])[] | "\(.name)\(" " * ([6 - (.name | length), 0] | max)) \(.target)");
    (map({key: .name, value: .label}) | from_entries) as $labels
    | (["auto-dev  \($now | strflocaltime("%H:%M"))", (.[] | repo), (.[] | live)] | map(trunc($cols))) as $head
    | {start: "🏃", end: "🏁", pr: "🔀", issue: "📝", decision: "🙋", fail: "🚨", notice: "💬"} as $icons
    | [$events | split("\n")[] | select(. != "") | split("\t") | select(length >= 4) | .[0] |= tonumber]
    | [sort_by(.[0])[] | "\(.[0] | when) \($labels[.[1]] // .[1][0:3]) \($icons[.[2]] // "・") \(.[3:] | join(" "))" | trunc($cols)]
      | reverse | .[:([$rows - ($head | length) - 2, 0] | max)] as $lines
    | $head[], (rule("── できごと") | trunc($cols)), $lines[]' <<< "$(status)"
}

# 判断待ち・見落とし・gh の失敗・失敗の通知があれば、ペインを待機中（赤い枠）にする
mark() {
  [ -n "$TMUX_PANE" ] || return 0
  if status | jq -e 'any(.[]; (.decisions | length) > 0 or .schedule.missed_at or .error or any(.notices[]; .title | test("失敗")))' \
    > /dev/null 2>&1; then
    tmux set -p -t "$TMUX_PANE" @claude_state waiting
  else
    tmux set -p -t "$TMUX_PANE" -u @claude_state
  fi
}

if [ "$mode" = --once ]; then
  frame
  mark
  exit 0
fi

tput civis
trap 'tput cnorm; exit 0' INT TERM
while true; do
  out=$(frame)
  tput cup 0 0
  printf '%s' "$out" | sed $'s/$/\033[K/'
  tput ed
  mark
  sleep "${CLAUDE_AUTO_DEV_WATCH_INTERVAL:-10}"
done
