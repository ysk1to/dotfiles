#!/bin/bash
# jq が必要（Brewfile に記載）
# Anthropic の usage API からプランの使用率を取得し、claude-statusline と同じ形式でキャッシュする。
# Claude Code を起動していない間も、デスクトップアプリなど他端末での利用を tmux に反映するために使う。
# トークンは Claude Code がキーチェーンに保存したものを使う（非公式 API のため、仕様が変わると取得できなくなる）

cache="${XDG_CACHE_HOME:-$HOME/.cache}/claude-rate-limits.json"

fetch() {
  local token
  token=$(security find-generic-password -s "Claude Code-credentials" -w 2>/dev/null | jq -r '.claudeAiOauth.accessToken // empty')
  [ -n "$token" ] || return 1
  curl -sf -m 10 https://api.anthropic.com/api/oauth/usage \
    -H "Authorization: Bearer $token" \
    -H "anthropic-beta: oauth-2025-04-20"
}

if [ -n "$CLAUDE_USAGE_FETCH" ]; then
  response=$(eval "$CLAUDE_USAGE_FETCH") || exit 1
else
  response=$(fetch) || exit 1
fi

# "2026-11-16T04:50:00.368943+00:00" のような UTC の時刻を UNIX 時刻に直す。
# Fable だけの週の枠は limits の weekly_scoped にあり、あれば seven_day_fable として足す
limits=$(echo "$response" | jq -ce '
  def epoch: sub("\\.[0-9]+"; "") | sub("\\+00:00$"; "Z") | fromdateiso8601;
  def window(w): w | select(.utilization != null and .resets_at != null)
    | {used_percentage: (.utilization | floor), resets_at: (.resets_at | epoch)};
  def fable: first(.limits[]? | select(.kind == "weekly_scoped" and .scope.model.display_name == "Fable")
    | select(.percent != null and .resets_at != null)
    | {used_percentage: (.percent | floor), resets_at: (.resets_at | epoch)});
  {five_hour: window(.five_hour), seven_day: window(.seven_day)}
  + ([fable] | if length > 0 then {seven_day_fable: .[0]} else {} end)
' 2>/dev/null) || exit 1

mkdir -p "$(dirname "$cache")"
echo "$limits" > "$cache.tmp" && mv "$cache.tmp" "$cache"
