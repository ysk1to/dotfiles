#!/bin/bash
# 指定ディレクトリで Claude Code を2ペインと自動開発の監視を1ペイン開くウィンドウを、共通の tmux セッション claude に作る
# 使い方: claude-team [ディレクトリ] [ウィンドウ名]
#   ディレクトリは ~/Program からの相対パス（例: works/xxx）か絶対パス
#   ディレクトリ省略時はカレントディレクトリ、ウィンドウ名省略時はディレクトリ名
#   案件名はリポジトリに書かず、スニペット（例: claude-team works/xxx）で呼び分ける
#   リポジトリをまたいで並行するときも、ウィンドウ（タブ）を切り替えるだけで済み、
#   ほかのリポジトリで Claude Code が待機中・完了かはステータスバーのウィンドウ番号の色でわかる
#   そのリポジトリのウィンドウがすでにあれば、作らずにそこへ移る
#
# +-----------+----------+
# |  Main     | Sub      |
# |           |          |
# |           +----------+
# |           | auto-dev |
# |           |          |
# +-----------+----------+

BASE="$HOME/Program"
SESSION=claude

case "$1" in
  "") target="$PWD" ;;
  /*) target="$1" ;;
  *) target="$BASE/$1" ;;
esac
DIR=$(cd "$target" 2>/dev/null && pwd) || { echo "ディレクトリが見つかりません: $target" >&2; exit 1; }
# tmux のターゲットの指定に使う . と : は _ に置き換える
WINDOW=$(printf '%s' "${2:-$(basename "$DIR")}" | tr '.:' '__')

attach_session() {
  tmux select-window -t "=$SESSION:=$WINDOW"
  if [ -n "$TMUX" ]; then
    tmux switch-client -t "=$SESSION"
  else
    tmux attach -t "=$SESSION"
  fi
}

# 既存のウィンドウがあればそこへ移る
if tmux has-session -t "=$SESSION" 2>/dev/null &&
  tmux list-windows -t "=$SESSION" -F '#{window_name}' | grep -Fxq -- "$WINDOW"; then
  echo "既存のウィンドウ '$WINDOW' に移ります..."
  attach_session
  exit 0
fi

# pane-base-index に依存しないよう、番号ではなくペインIDで扱う
# -n で名前を付けたウィンドウは automatic-rename が切れ、実行中のコマンド名に変わらない
if tmux has-session -t "=$SESSION" 2>/dev/null; then
  main=$(tmux new-window -d -t "=$SESSION:" -n "$WINDOW" -c "$DIR" -P -F '#{pane_id}')
else
  main=$(tmux new-session -d -s "$SESSION" -n "$WINDOW" -c "$DIR" -P -F '#{pane_id}')
fi
sub=$(tmux split-window -h -t "$main" -c "$DIR" -P -F '#{pane_id}')
watch=$(tmux split-window -v -t "$sub" -c "$DIR" -P -F '#{pane_id}')

tmux select-pane -t "$main" -T Main
tmux select-pane -t "$sub" -T Sub

# 終了後もシェルが残るよう send-keys で起動する
for pane in "$main" "$sub"; do
  tmux send-keys -t "$pane" claude Enter
done
# 右下は自動開発の監視（claude-auto-dev-watch。ペインの名前は自分で auto-dev にする）。ディレクトリがリポジトリ
# （worktree なら元のリポジトリ）の中なら、そのリポジトリに絞る。シェルは C-q + S のポップアップで開く
watch_cmd=claude-auto-dev-watch
common=$(git -C "$DIR" rev-parse --path-format=absolute --git-common-dir 2>/dev/null) &&
  watch_cmd="$watch_cmd --repo $(printf '%q' "$(basename "$(dirname "$common")")")"
tmux send-keys -t "$watch" "$watch_cmd" Enter

tmux select-pane -t "$main"
attach_session
