#!/bin/bash
# claude-statusline と claude-usage-refresh がキャッシュしたプランの使用率を tmux のステータスバー向けに出力する。
# 例: ⏳ 5h ▰▰▱▱▱ 42% ↻16:00 📆 7d ▰▱▱▱▱ 18% 🐉 Fable ▰▱▱▱▱ 35%
# Fable の週の枠（seven_day_fable）は、キャッシュにあるときだけ出す
# 使用率は 50% 未満を緑、80% 未満を黄、それ以上を赤で表示する

cache="${XDG_CACHE_HOME:-$HOME/.cache}/claude-rate-limits.json"

# 他端末での利用も反映するため、1時間おきに claude-usage-refresh をバックグラウンドで起動する。
# 起動した時刻を記録して、取得に失敗しても API を呼びすぎないようにする
stamp="$cache.checked"
if [ -z "$(find "$stamp" -mmin -60 2>/dev/null)" ]; then
  mkdir -p "$(dirname "$cache")"
  touch "$stamp"
  (eval "${CLAUDE_USAGE_REFRESH:-$(dirname "$0")/claude-usage-refresh}" > /dev/null 2>&1 &)
fi

[ -f "$cache" ] || { echo "⏳ 5h -- 📆 7d --"; exit 0; }

jq -r --argjson now "$(date +%s)" '
  def active(w): w and w.resets_at > $now;
  def color(p): if p >= 80 then "colour203" elif p >= 50 then "colour221" else "colour120" end;
  def bar(p): (p / 20 | floor) as $n | ("▰" * $n) + ("▱" * (5 - $n));
  def seg(name; w):
    if active(w) then
      (w.used_percentage | floor) as $p
      | "\(name) #[fg=\(color($p))]\(bar($p)) #[bold]\($p)%#[nobold,fg=default]"
    else "\(name) --" end;
  def reset(w): if active(w) then " #[fg=colour248]↻\(w.resets_at | strflocaltime("%H:%M"))#[fg=default]" else "" end;
  def fable: if active(.seven_day_fable) then " \(seg("🐉 Fable"; .seven_day_fable))" else "" end;
  "\(seg("⏳ 5h"; .five_hour))\(reset(.five_hour)) \(seg("📆 7d"; .seven_day))\(fable)"
' "$cache"
