#!/bin/bash
# claude-statusline がキャッシュしたプランの使用率を tmux のステータスバー向けに出力する。
# 例: 5h 42%(16:00) 7d 18%

cache="${XDG_CACHE_HOME:-$HOME/.cache}/claude-rate-limits.json"
[ -f "$cache" ] || { echo "5h -- 7d --"; exit 0; }

jq -r --argjson now "$(date +%s)" '
  def pct(w): if w and w.resets_at > $now then "\(w.used_percentage | floor)%" else "--" end;
  def reset(w): if w and w.resets_at > $now then "(\(w.resets_at | strflocaltime("%H:%M")))" else "" end;
  "5h \(pct(.five_hour))\(reset(.five_hour)) 7d \(pct(.seven_day))"
' "$cache"
