#!/bin/bash
# claude-auto-dev の状況（claude-auto-dev-status --json）を、tmux のステータスバー（2行目）向けに絵文字と件数で出力する。
# 例: 🔧 kbi  🏃 #14 12m  🙋 1  🔀 2  │  foo  ✓  │  ⏩ 20:00  🔁 4  ⏳ 1h52m
#   リポジトリごとに略称と件数を並べる（0件のものは出さない。何もなければ ✓）
#   🏃 実行中の回（#Issue・企画・探索・精査と経過時間）/ 🙋 判断待ちの Issue / 🔀 開いている PR / 📥 着手できる Issue
#   🚨 起動の見落とし・gh の失敗・直近の失敗の通知
#   最後に、全リポジトリで 🍃 Eco・🚀 Boost ペース配分の段階（Normal は出さない）/ ⏩ いちばん近い次の起動 /
#   🔁 今日の回数 / ⏳ 今日のかかった時間
#   自動開発のリポジトリがなければ何も出さない
# 使い方: tmux-claude-auto-dev [--popup | --running]
#   --popup で凡例と状況の全文を出す（tmux の display-popup から呼ぶ）
#   --running で実行中の回だけを、{ リポジトリ名: ロックの run } の JSON で出す（claude-auto-dev-watch が使う）
# status-interval ごとに gh を呼ばないよう、結果をキャッシュし、古くなったら裏で取り直す（待たせない）。
# キャッシュの有効期間は TMUX_AUTO_DEV_TTL（秒、既定 300）で変更できる。
# 実行中の回はすぐ変わるので、キャッシュでなく claude-auto-dev のロックを毎回読む

status="${TMUX_AUTO_DEV_STATUS:-$(dirname "$0")/claude-auto-dev-status}"
cache="${XDG_CACHE_HOME:-$HOME/.cache}/claude-auto-dev-status.json"
ttl="${TMUX_AUTO_DEV_TTL:-300}"
state_dir="${CLAUDE_AUTO_DEV_STATE_DIR:-$HOME/.local/state/claude-auto-dev}"
now="${CLAUDE_AUTO_DEV_NOW:-$(date +%s)}"

if [ "$1" = --popup ]; then
  echo "🏃 実行中の回（#Issue・企画・探索・精査と経過時間）  🙋 判断待ちの Issue  🔀 開いている PR  📥 着手できる Issue"
  echo "🚨  起動の見落とし・gh の失敗・直近の失敗の通知"
  echo "⏩ 次の起動  🔁 今日の回数  ⏳ 今日のかかった時間  ※ 全リポジトリの合計"
  echo "🍃 Eco 週の使用率が目標より上（実装だけを2時間おき）  🚀 Boost 土曜のリセット前の24時間（続けて動かす）"
  echo
  "$status"
  exit 0
fi

# 実行中の回を { 名前: run の JSON } にまとめる。落ちてロックだけ残っているもの（pid のプロセスがない）は除く
running='{}'
for lock in "$state_dir"/locks/*; do
  if [ ! -f "$lock/run" ] || ! kill -0 "$(cat "$lock/pid" 2>/dev/null)" 2>/dev/null; then
    continue
  fi
  running=$(jq -c --arg name "$(basename "$lock")" --slurpfile run "$lock/run" '.[$name] = $run[0]' <<< "$running" 2>/dev/null) ||
    running='{}'
done
if [ "$1" = --running ]; then
  echo "$running"
  exit 0
fi

# 前回取り直してから有効期間がたっていれば、裏で取り直す。取り直しを始めた時刻を記録して、
# 失敗が続いても gh を呼びすぎないようにする。失敗したときは前のキャッシュを残す
age() { echo $(($(date +%s) - $(stat -f %m "$1" 2>/dev/null || echo 0))); }
stamp="$cache.checked"
if [ "$(age "$cache")" -ge "$ttl" ] && [ "$(age "$stamp")" -ge "$ttl" ]; then
  mkdir -p "$(dirname "$cache")"
  touch "$stamp"
  ( { "$status" --json > "$cache.tmp" && jq -e 'type == "array"' "$cache.tmp" > /dev/null && mv "$cache.tmp" "$cache"; } \
    > /dev/null 2>&1 & )
fi

# ペース配分の段階は、claude-auto-dev が起動のたびに pace/<名前> に残す。いちばん新しいものを出す。
# 起動が止まっていると古い段階が残るので、3時間より古いものは出さない
pace=
# shellcheck disable=SC2012 # 新しい順に並べるため。ファイル名はリポジトリの名前だけ
pace_file=$(ls -t "$state_dir"/pace/* 2>/dev/null | head -n 1)
if [ -n "$pace_file" ] && [ "$(age "$pace_file")" -lt "${TMUX_AUTO_DEV_PACE_TTL:-10800}" ]; then
  case "$(cat "$pace_file" 2>/dev/null)" in
    eco) pace="🍃 Eco" ;;
    boost) pace="🚀 Boost" ;;
  esac
fi

[ -f "$cache" ] || { echo "🔧 …"; exit 0; }

jq -r --argjson running "$running" --argjson now "$now" --arg pace "$pace" '
  def duration: (. / 60 | round) as $m | if $m >= 60 then "\($m / 60 | floor)h\($m % 60 | tostring | if length < 2 then "0" + . else . end)m" else "\($m)m" end;
  def elapsed: (($now - .) / 60 | floor) as $m | if $m >= 60 then "\($m / 60 | floor)h\($m % 60 | tostring | if length < 2 then "0" + . else . end)m" else "\($m)m" end;
  def run: if .mode == "implement" then "#\(.issue)" elif .mode == "plan" then "企画" elif .mode == "explore" then "探索" else "精査" end + " \(.started_at | elapsed)";
  def segment:
    ($running[.name] // null) as $r | .label as $label
    | (.schedule.missed_at or .error or any(.notices[]; (.title | test("失敗")) and (.resolved | not))) as $warn
    | [if $r then "🏃 \($r | run)" else empty end,
       (.decisions | length) as $d | if $d > 0 then "🙋 \($d)" else empty end,
       (.prs | length) as $p | if $p > 0 then "🔀 \($p)" else empty end,
       if .ready > 0 then "📥 \(.ready)" else empty end,
       if $warn then "🚨" else empty end]
    | "\($label)  " + (if length == 0 then "✓" else join("  ") end);
  if length == 0 then empty else
    ([.[].schedule.next_at // empty] | min) as $next
    | (map(.runs.today.count) | add) as $count
    | (map(.runs.today.duration // 0) | add) as $duration
    | [if $pace != "" then $pace else empty end,
       if $next then "⏩ \($next | strflocaltime("%H:%M"))" else empty end,
       if $count > 0 then "🔁 \($count)  ⏳ \($duration | duration)" else empty end] as $total
    | "🔧 " + ([.[] | segment] + (if ($total | length) > 0 then [$total | join("  ")] else [] end) | join("  │  "))
  end' "$cache" 2>/dev/null
