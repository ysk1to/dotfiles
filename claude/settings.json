{
  "cleanupPeriodDays": 365,
  "env": {
    "EDITOR": "code --wait"
  },
  "permissions": {
    "allow": [
      "Bash(git blame:*)",
      "Bash(git branch --list:*)",
      "Bash(git branch --show-current)",
      "Bash(git branch)",
      "Bash(git cat-file:*)",
      "Bash(git describe:*)",
      "Bash(git diff:*)",
      "Bash(git fetch:*)",
      "Bash(git grep:*)",
      "Bash(git log:*)",
      "Bash(git ls-files:*)",
      "Bash(git ls-remote:*)",
      "Bash(git remote -v)",
      "Bash(git remote)",
      "Bash(git rev-list:*)",
      "Bash(git rev-parse:*)",
      "Bash(git shortlog:*)",
      "Bash(git show:*)",
      "Bash(git stash list:*)",
      "Bash(git status:*)",
      "Bash(git tag --list:*)",
      "Bash(git tag)",
      "Glob",
      "Grep",
      "Read",
      "Read(//private/tmp/**)",
      "Read(//tmp/**)",
      "WebFetch",
      "WebSearch",
      "mcp__serena"
    ],
    "deny": [
      "Bash(rm -rf /)",
      "Bash(rm -rf /*)",
      "Bash(sudo rm -rf /)",
      "Bash(format*)",
      "Bash(mkfs*)",
      "Read(~/.ssh/**)",
      "Read(~/.aws/**)"
    ],
    "ask": [
      "Agent"
    ]
  },
  "hooks": {
    "Notification": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "~/bin/tmux-claude-notify waiting",
            "timeout": 5
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "~/bin/tmux-claude-notify running",
            "timeout": 5
          }
        ]
      }
    ],
    "SessionEnd": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "~/bin/tmux-claude-notify running",
            "timeout": 5
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "~/bin/tmux-claude-notify done",
            "timeout": 5
          }
        ]
      }
    ],
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "~/bin/tmux-claude-notify running",
            "timeout": 5
          }
        ]
      }
    ]
  },
  "language": "japanese",
  "tui": "fullscreen",
  "enabledPlugins": {
    "gopls-lsp@claude-plugins-official": true
  },
  "statusLine": {
    "type": "command",
    "command": "~/bin/claude-statusline"
  },
  "model": "opus",
  "effortLevel": "medium",
  "spinnerVerbs": {
    "mode": "replace",
    "verbs": [
      "☕ Brewing ideas",
      "🧠 Connecting dots",
      "💭 Mulling it over",
      "🧩 Fitting pieces",
      "🪡 Weaving logic",
      "⚗️ Distilling",
      "🌀 Untangling",
      "✨ Polishing thoughts",
      "🗺️ Charting a course",
      "🔭 Seeing the big picture",
      "🎯 Zeroing in",
      "🪄 Working the magic",
      "♟️ Thinking a few moves ahead",
      "🌱 Letting it grow",
      "🎛️ Fine-tuning",
      "🫖 Letting it steep",
      "🧭 Finding the way",
      "💡 Chasing a spark",
      "🎼 Composing",
      "🛠️ Crafting"
    ]
  },
  "theme": "dark",
  "editorMode": "normal",
  "autoCompactEnabled": true
}
